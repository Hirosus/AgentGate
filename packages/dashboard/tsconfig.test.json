{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "outDir": "dist-test",
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/data/gemini-report.json",
    "src/data/latest-report.json",
    "src/data/mcp-catalog.json",
    "src/data/scenarios.json",
    "src/lib/evalData.ts",
    "src/lib/triageCatalog.ts",
    "src/lib/triageEngine.ts",
    "src/lib/triagePreview.ts",
    "tests/evalData.test.ts",
    "tests/triageEngine.test.ts"
  ]
}
