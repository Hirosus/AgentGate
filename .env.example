# Webhook authentication & replay protection
AGENTGATE_WEBHOOK_SECRET=replace-with-32-byte-random-hex-secret
AGENTGATE_WEBHOOK_MAX_AGE_SECONDS=300

# State persistence (sqlite for local zero-Docker dev; dynamodb on AWS)
AGENTGATE_STORE_BACKEND=sqlite
AGENTGATE_SQLITE_PATH=./data/agentgate.db
IDEMPOTENCY_TABLE=

# Primary live LLM provider (Google Gemini API free tier; leave empty for offline/CI runs)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional later stage: OpenAI-compatible endpoints (Groq, OpenRouter, Mistral, Ollama, OpenAI)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Trace & eval observability (local OTel-shaped JSON default + optional Langfuse export)
AGENTGATE_TRACE_PATH=./data/traces.jsonl
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# AWS deployment target (Serverless AWS SAM)
AWS_REGION=eu-west-1
