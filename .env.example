# Webhook authentication & replay protection
AGENTGATE_WEBHOOK_SECRET=replace-with-32-byte-random-hex-secret
# Optional override for Next.js dashboard /api/triage demo signer (falls back to AGENTGATE_WEBHOOK_SECRET)
AGENTGATE_DEMO_WEBHOOK_SECRET=
AGENTGATE_WEBHOOK_MAX_AGE_SECONDS=300
AGENTGATE_IDEMPOTENCY_TTL_SECONDS=86400
# Set to true only when migrating legacy v1= callers; default requires key-bound v2= signatures
AGENTGATE_ALLOW_LEGACY_V1=false
# Inline webhook triage hook: none (intake-only) or deterministic (inline run_deterministic_triage)
AGENTGATE_TRIAGE_MODE=none
# Optional max HTTP webhook payload size in bytes (default: 1048576 / 1 MiB)
AGENTGATE_MAX_BODY_BYTES=1048576

# State persistence (sqlite for local zero-Docker dev; dynamodb on AWS; memory for ephemeral tests)
AGENTGATE_STORE_BACKEND=sqlite
AGENTGATE_SQLITE_PATH=./data/agentgate.db
IDEMPOTENCY_TABLE=
AWS_REGION=eu-west-1

# Live LLM provider (Google Gemini REST; leave empty for offline/CI runs or dashboard deterministic fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional Langfuse trace export for agentgate-eval (JSONL OTel traces are always written locally)
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Webhook producer / client target base URL (used by integrations/n8n/alert-triage-workflow.json)
AGENTGATE_BASE_URL=http://127.0.0.1:8000
